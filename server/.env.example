# Copy to .env and fill in real values
#
# DATABASE_URL — the app's RUNTIME connection, used by every request the server handles.
# Use Neon's POOLED connection string (hostname contains "-pooler", e.g.
# ep-xxx-pooler.region.aws.neon.tech) so concurrent requests share Neon's PgBouncer pool
# instead of each opening its own direct Postgres connection.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
#
# DIRECT_DATABASE_URL — used ONLY by Prisma CLI schema operations (migrate, db push).
# Use Neon's DIRECT (non-pooled, no "-pooler" in hostname) connection string — Prisma's
# migration engine requires a direct connection and does not work through the pooler.
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/db?sslmode=require"
PORT=3001
FRONTEND_URL=http://localhost:5173
GITHUB_TOKEN=your_github_token_here
GEMINI_API_KEY=your_gemini_api_key_here
AUTH_SECRET=your_jwt_secret_here_change_in_production
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="FairTraze AI <onboarding@resend.dev>"
# Master switch for ALL email features. Defaults to on (unset or any value other than the
# literal "false"). When "false": no email is ever sent (verification, resend, password
# reset), new sign-ups are verified automatically, existing unverified users count as
# verified (nothing is blocked), and the client hides the verify banner and "Forgot password?".
EMAIL_ENABLED=true
# Set to "false" to disable the email-verification requirement gate and skip
# sending verification emails on registration. Defaults to enforced (any
# value other than the literal "false", including unset, enforces the gate).
REQUIRE_EMAIL_VERIFICATION=true
# Number of reverse proxies in front of the server. Leave 0 locally; set 1 on Render so rate limits
# see each visitor's real IP instead of the proxy's (otherwise everyone shares one bucket).
TRUST_PROXY_HOPS=0

# Shared secret for the nightly automatic analysis (POST /api/internal/analyze-due, header x-cron-secret).
# Generate a long random value, e.g. `openssl rand -hex 32`, and set the SAME value as the CRON_SECRET
# repository secret used by .github/workflows/nightly-analysis.yml. Unset = the endpoint answers 503.
CRON_SECRET=

# AI review (member work summaries, brief check). Off unless "true". Demo uses Gemini's free tier.
AI_REVIEW_ENABLED=false
# Max AI review calls per UTC day, per server process (default 600).
AI_REVIEW_DAILY_CALL_CAP=600
