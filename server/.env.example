# Copy to .env and fill in real values
# Use the DIRECT (non-pooled, no "-pooler" in hostname) Neon connection string —
# Prisma CLI schema operations (migrate, db push) require a direct connection.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
PORT=3001
FRONTEND_URL=http://localhost:5173
GITHUB_TOKEN=your_github_token_here
GEMINI_API_KEY=your_gemini_api_key_here
AUTH_SECRET=your_jwt_secret_here_change_in_production
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="FairTraze AI <onboarding@resend.dev>"