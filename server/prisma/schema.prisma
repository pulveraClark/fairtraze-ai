generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum SystemRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum SourceType {
  GITHUB
  EDITOR
  COMBINED
}

enum AttachmentKind {
  IMAGE
  PDF
}

enum MembershipRole {
  LEADER
  MEMBER
}

enum ClassType {
  LECTURE
  LABORATORY
}

enum AlertType {
  HIGH_RISK
  MODERATE_RISK
  MEMBER_FLAGGED
  DISPUTE_FILED
  JOIN_REQUEST_RECEIVED
  JOIN_REQUEST_ACCEPTED
  JOIN_REQUEST_DECLINED
  TASK_ASSIGNED
  DISPUTE_RESPONDED
  ACCOUNT_LOCKED
  COMMENT_REPLY
  REPORT_READY
  LEADER_CHANGED
  MEMBER_REMOVED
  ROLE_SUGGESTION_RECEIVED
  ROLE_SUGGESTION_RESOLVED
  GROUP_CREATED
  DEPARTMENT_CREATED
  USER_REGISTERED
  INSTRUCTOR_APPROVED
  INSTRUCTOR_REJECTED
  DELETION_REQUESTED
  DELETION_APPROVED
  DELETION_REJECTED
  TASK_MENTIONED
  TASK_COMMENTED
  TASK_STATUS_CHANGED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Admin sign-off for self-registered instructors. Only meaningful when systemRole is
// INSTRUCTOR; the default APPROVED backfills every pre-existing row (and seed data).
enum InstructorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum EditEventType {
  INSERT
  DELETE
}

// Rule-based classification of an INSERT edit's significance (Step 4b). Mirrors the GitHub
// side's commit-impact classes (structural/functional/cosmetic/trivial). Only populated on
// INSERT rows — DELETE rows and any edit predating this feature stay null (treated as a
// neutral 1.0 weight so pre-migration data isn't retroactively penalized).
enum EditType {
  SUBSTANTIVE
  REVISION
  FORMATTING
  TRIVIAL
}

// Distinguishes live-typed rows from a future .docx-import feature. IMPORT is schema
// groundwork only — nothing produces it yet; every row today is LIVE.
enum EditSource {
  LIVE
  IMPORT
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  passwordHash     String
  name             String
  systemRole       SystemRole        @default(STUDENT)
  githubUsername   String?
  active           Boolean           @default(true)
  // Default true so a migration backfills every pre-existing row (seeded demo
  // accounts, any real accounts registered before this feature shipped) as
  // already verified. The register route explicitly overrides this to false
  // for newly created accounts — see server/src/routes/auth.ts.
  emailVerified    Boolean           @default(true)
  failedLoginAttempts Int            @default(0)
  lockedUntil      DateTime?
  instructorStatus InstructorStatus  @default(APPROVED)
  approvalReviewedAt   DateTime?
  approvalReviewedById Int?
  createdAt        DateTime          @default(now())
  // Optional profile photo (256x256 WebP/JPEG, <=~200KB), stored in-DB because Render's disk is ephemeral.
  avatarData       Bytes?
  avatarMime       String?
  avatarUpdatedAt  DateTime?
  // Privacy consent (RA 10173): the notice version the user accepted and when. NULL = never
  // accepted (every pre-existing account), which re-prompts on next login.
  consentVersion    String?
  consentAcceptedAt DateTime?
  // Set when an erasure request is approved: the row becomes an anonymized tombstone so every
  // FK (edit events, contributions, tasks, comments) and every stored report keeps resolving.
  deletedAt         DateTime?
  deletionRequests  DeletionRequest[]
  classSections    ClassSection[]
  groupMemberships GroupMembership[]
  classEnrollments ClassEnrollment[]
  alerts           Alert[]           @relation("AlertInstructor")
  receivedAlerts   Alert[]           @relation("AlertRecipient")
  disputes         Dispute[]
  auditLogs        AuditLog[]
  joinRequests     GroupJoinRequest[]
  roleSuggestions  RoleSuggestion[]
  editEvents       EditEvent[]
  editSessions     EditSession[]
  refreshTokens    RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  tasksAssigned    Task[]            @relation("TaskAssignee")
  tasksCreated     Task[]            @relation("TaskCreator")
  taskActivity     TaskActivity[]    @relation("TaskActivityActor")
  taskAttachments  TaskAttachment[]  @relation("TaskAttachmentCreator")
  taskComments     TaskComment[]     @relation("TaskCommentAuthor")
  taskWatching     TaskWatcher[]     @relation("TaskWatcherUser")
  comments         Comment[]
  documentContributions DocumentContribution[]
  combinedContributions CombinedContribution[]
}

model DeletionRequest {
  id           Int                   @id @default(autoincrement())
  userId       Int
  status       DeletionRequestStatus @default(PENDING)
  reason       String?
  createdAt    DateTime              @default(now())
  reviewedAt   DateTime?
  reviewedById Int?
  reviewNote   String?
  user         User                  @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id            Int            @id @default(autoincrement())
  name          String
  code          String
  createdAt     DateTime       @default(now())
  classSections ClassSection[]
}

model ClassSection {
  id           Int               @id @default(autoincrement())
  subjectCode  String
  subjectName  String
  departmentId Int
  edpCode      String            @default("")
  type         ClassType         @default(LECTURE)
  joinCode     String?           @unique
  instructorId Int
  createdAt    DateTime          @default(now())
  instructor   User              @relation(fields: [instructorId], references: [id])
  department   Department        @relation(fields: [departmentId], references: [id])
  assignments  Assignment[]
  enrollments  ClassEnrollment[]

  @@unique([instructorId, edpCode])
}

model ClassEnrollment {
  id             Int          @id @default(autoincrement())
  userId         Int
  classSectionId Int
  joinedAt       DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([userId, classSectionId])
}

model Assignment {
  id             Int          @id @default(autoincrement())
  classSectionId Int
  title          String
  deadline       DateTime?
  maxGroupSize   Int          @default(5)
  sourceType     SourceType
  joinCode       String       @unique
  // Instructor-written project brief (plain text, max 5000 chars). Context only — never read by scoring.
  description    String?
  // Scoring configuration, set once per project (Assignment) and applied to every group in it.
  // Defaults mirror shared/src/scoring.ts constants. The same-named columns on Project are legacy:
  // kept for now, no longer read or written.
  weightCommits            Float @default(0.4)
  weightLines              Float @default(0.4)
  weightActiveDays         Float @default(0.2)
  freeRiderThreshold       Float @default(0.5)
  overloadThreshold        Float @default(1.75)
  deadlineDrivenThreshold  Float @default(0.6)
  weightGithub             Float @default(0.5)
  weightDocs               Float @default(0.5)
  createdAt      DateTime     @default(now())
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  projects       Project[]
  attachments    ProjectAttachment[]
}

// Brief attachments (<=5 images + <=1 PDF per assignment). Stored in Postgres because
// Render's disk is ephemeral. Display only — never read by scoring, collab or analyze.
model ProjectAttachment {
  id           Int            @id @default(autoincrement())
  assignmentId Int
  kind         AttachmentKind
  mime         String
  data         Bytes
  size         Int
  filename     String
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, order])
}

model GroupMembership {
  id              Int            @id @default(autoincrement())
  userId          Int
  projectId       Int
  role            MembershipRole @default(MEMBER)
  // JSON array of functional roles: ["DEVELOPER"] | ["DOCUMENTATION"] | ["DEVELOPER","DOCUMENTATION"] | []
  // Default ["DEVELOPER"]: all existing/new groups are GitHub-based; Developer is the correct starting point.
  // The leader (or instructor) can always reassign. Never affects scoring — context only.
  functionalRoles String         @default("[\"DEVELOPER\"]")
  joinedAt        DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id])
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Project {
  id                       Int               @id @default(autoincrement())
  groupName                String            @default("")   // student team name, e.g. "Group 1"
  name                     String                            // app/project name, e.g. "FairTraze AI"
  repoUrl                  String                            // GitHub repository URL
  assignmentLabel          String            @default("")   // fallback display string, e.g. "CC-APPSDEV22 — Applications Development"
  assignmentId             Int?
  membershipChangedAt      DateTime?                         // updated when members join or leave; used to detect stale reports
  // LEGACY per-group scoring configuration: superseded by the same fields on Assignment and no
  // longer read or written. Kept (not dropped) for now. scoringConfigChangedAt below is still live.
  weightCommits            Float             @default(0.4)
  weightLines              Float             @default(0.4)
  weightActiveDays         Float             @default(0.2)
  freeRiderThreshold       Float             @default(0.5)
  overloadThreshold        Float             @default(1.75)
  deadlineDrivenThreshold  Float             @default(0.6)
  // COMBINED-only blend weights (GitHub share vs. Docs share); harmless defaults for GITHUB/EDITOR-only projects
  weightGithub             Float             @default(0.5)
  weightDocs               Float             @default(0.5)
  scoringConfigChangedAt   DateTime?                         // set when config changes after last analyze; cleared by re-analyze
  // Tasks board: short key used in task ids ("FT-12"). NULL = not chosen yet; derived from groupName
  // (lib/taskKey.ts) and persisted when the group's first task is created. nextTaskNumber is the
  // per-group counter, allocated atomically. Neither is ever read by scoring.
  taskKey                  String?
  nextTaskNumber           Int               @default(1)
  createdAt                DateTime          @default(now())
  assignment               Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  members                  Member[]
  reports                  Report[]
  groupMemberships         GroupMembership[]
  alerts                   Alert[]
  disputes                 Dispute[]
  joinRequests             GroupJoinRequest[]
  roleSuggestions          RoleSuggestion[]
  document                 Document?
  tasks                    Task[]
  taskMilestones           TaskMilestone[]
  taskLabels               TaskLabel[]
}

// Leader/instructor-assigned sub-tasks for deliverables GitHub and the
// Collaborative Editor can't see (a poster, a physical prototype, a
// presentation). Purely informational — self-reported completion is
// trivially gameable, so it is never read by shared/src/scoring.ts and
// never fed into contributionShare/flags/Gini. See taskSummary on the
// report for how it's surfaced instead (context only, like functionalRoles).
model Task {
  id               Int          @id @default(autoincrement())
  projectId        Int
  // Per-group number: the "12" in "FT-12". Unique within a group, never reused.
  number           Int
  title            String
  description      String?
  assignedToUserId Int?
  createdByUserId  Int
  // Legacy completion flag, kept in sync with status (done = status DONE) by one writer
  // (lib/taskBoard.ts#statusFields) until the final cleanup migration drops it.
  done             Boolean      @default(false)
  completedAt      DateTime?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  // Calendar date only (no time zone): the day the task is due.
  dueDate          DateTime?    @db.Date
  // Order within a column: a double that new cards place between two neighbours (midpoint);
  // the column is renumbered when the gap gets too small. Ties break on id.
  position         Float        @default(0)
  // Bumped by every write; clients send the version they last saw and get 409 on a mismatch.
  version          Int          @default(1)
  milestoneId      Int?
  // Text of a heading in the group's document this task is linked to (no Yjs involvement).
  docHeading       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo       User?        @relation("TaskAssignee", fields: [assignedToUserId], references: [id])
  createdBy        User         @relation("TaskCreator", fields: [createdByUserId], references: [id])
  milestone        TaskMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  labelLinks       TaskLabelLink[]
  activity         TaskActivity[]
  subtasks         TaskSubtask[]
  attachments      TaskAttachment[]
  comments         TaskComment[]
  watchers         TaskWatcher[]

  @@unique([projectId, number])
  @@index([projectId, status, position])
  @@index([assignedToUserId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model TaskMilestone {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  dueDate   DateTime? @db.Date
  position  Float    @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, position])
}

model TaskLabel {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  color     String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links     TaskLabelLink[]

  @@index([projectId])
}

model TaskLabelLink {
  taskId  Int
  labelId Int
  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

// The History tab. Stores user ids and ids/values only (never display names), so account erasure
// ("Former member") needs no rewrite. actorId is null for system entries (e.g. a linked commit).
model TaskActivity {
  id        Int      @id @default(autoincrement())
  taskId    Int
  actorId   Int?
  type      String
  data      Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User?    @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

// Task details (phase 4). Planning data only: nothing here is read by scoring.
model TaskSubtask {
  id        Int      @id @default(autoincrement())
  taskId    Int
  title     String
  done      Boolean  @default(false)
  position  Float    @default(0)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

// Stored in Postgres (Render's disk is ephemeral), same rules as the project brief attachments.
model TaskAttachment {
  id          Int            @id @default(autoincrement())
  taskId      Int
  // Denormalised so the 50 MB per-group total is one indexed sum.
  projectId   Int
  kind        AttachmentKind
  mime        String
  data        Bytes
  size        Int
  filename    String
  createdById Int?
  createdAt   DateTime       @default(now())
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("TaskAttachmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([projectId])
}

// body holds <@userId> mention tokens; names are rendered by the client from the live member list.
model TaskComment {
  id        Int       @id @default(autoincrement())
  taskId    Int
  authorId  Int
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User      @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model TaskWatcher {
  taskId    Int
  userId    Int
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("TaskWatcherUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Member {
  id             Int     @id @default(autoincrement())
  projectId      Int
  studentName    String
  githubUsername String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Report {
  id                    Int                    @id @default(autoincrement())
  projectId             Int
  generatedAt           DateTime               @default(now())
  gini                  Float?
  teamHealth            String?
  content               String?
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentContributions DocumentContribution[]
  combinedContributions CombinedContribution[]
  documentSnapshots     DocumentSnapshot[]
}

// Normalized per-member persistence of a single analysis run's document-side (Editor) scores,
// alongside — not replacing — the existing full-blob Report.content JSON. Written as a
// side-effect right after the owning Report row is created (server/src/routes/analyze.ts); every
// value here is already computed by shared/src/documentScoring.ts, so this is a pure persistence-
// shape addition with zero new computation and zero interaction with the live collab pipeline.
// Field list matches the manuscript's DOCUMENT_CONTRIBUTION data dictionary (Table 61).
model DocumentContribution {
  id                        Int      @id @default(autoincrement())
  documentId                Int
  userId                    Int
  reportId                  Int
  netRetainedChars          Int
  weightedRetainedChars     Float
  effectiveRetainedChars    Float
  totalCharsInserted        Int
  totalCharsDeleted         Int
  selfChurnRatio            Float
  editSessionCount          Int
  activeEditingDays         Int
  lastPhaseRatio            Float
  retainedTextShare         Float
  sessionShare              Float
  activeDaysShare           Float
  documentContributionShare Float
  computedAt                DateTime @default(now())
  document                  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user                      User     @relation(fields: [userId], references: [id])
  report                    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// Normalized per-member persistence of a single COMBINED analysis run's blended scores,
// alongside the existing Report.content JSON, same rationale as DocumentContribution above.
// Field list matches the manuscript's COMBINED_CONTRIBUTION data dictionary (Table 62).
model CombinedContribution {
  id                        Int      @id @default(autoincrement())
  reportId                  Int
  userId                    Int
  githubContributionShare   Float
  documentContributionShare Float
  wGitHub                   Float
  wDocs                     Float
  combinedContributionShare Float
  flags                     String // JSON array of Flag strings
  mismatchNotes             String? // JSON array, nullable
  computedAt                DateTime @default(now())
  report                    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user                      User     @relation(fields: [userId], references: [id])

  @@index([reportId])
}

// Per-recipient notification. Originally instructor-only (instructorId /
// projectId / teamHealth); now generalised via recipientId + link + ref*.
// instructorId stays populated for the four legacy instructor types.
model Alert {
  id           Int       @id @default(autoincrement())
  projectId    Int?
  instructorId Int?
  recipientId  Int?
  type         AlertType
  message      String
  teamHealth   String?
  link         String?
  refType      String?
  refId        Int?
  read         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instructor   User?     @relation("AlertInstructor", fields: [instructorId], references: [id])
  recipient    User?     @relation("AlertRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read, createdAt])
}

model Dispute {
  id                 Int           @id @default(autoincrement())
  projectId          Int
  studentUserId      Int
  memberName         String
  reason             String
  status             DisputeStatus @default(OPEN)
  instructorResponse String?
  disputedFlags      String        @default("") // JSON array of Flag strings captured at submission time; "" means pre-feature (use fallback from latest report)
  createdAt          DateTime      @default(now())
  resolvedAt         DateTime?
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student            User          @relation(fields: [studentUserId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actorName  String
  action     String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model GroupJoinRequest {
  id         Int               @id @default(autoincrement())
  userId     Int
  projectId  Int
  status     JoinRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?
  user       User              @relation(fields: [userId], references: [id])
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RoleSuggestion {
  id             Int               @id @default(autoincrement())
  userId         Int
  projectId      Int
  // JSON array: ["DEVELOPER"] | ["DOCUMENTATION"] | ["DEVELOPER","DOCUMENTATION"]
  suggestedRoles String
  status         JoinRequestStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?
  user           User              @relation(fields: [userId], references: [id])
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Document {
  id        Int      @id @default(autoincrement())
  groupId   Int      @unique
  // TipTap/ProseMirror document JSON, stringified. Default is a valid empty doc.
  // Legacy Step-1 field — superseded by yjsState once a collaboration room has run at least once.
  content   String   @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  // Raw Yjs update state (Y.encodeStateAsUpdate). Source of truth for live collaborative content.
  yjsState  Bytes?
  // Paper size for the page view / PDF export, shared by all collaborators: LETTER | LEGAL | A4
  // (shared/src/pageSizes.ts). Layout only — never read by scoring, never part of the Yjs doc.
  pageSize  String   @default("LETTER")
  // Page setup + header/footer text (migration 20261016100000_document_page_setup). Same rules as
  // pageSize: shared by every collaborator, layout only, plain columns - never in the Yjs doc and
  // never read by scoring. orientation: PORTRAIT | LANDSCAPE; marginPreset: NORMAL | NARROW | WIDE | CUSTOM
  // (shared/src/pageSizes.ts). Header/footer slots are plain text (max 120 chars; {page} = page number).
  orientation  String @default("PORTRAIT")
  marginPreset String @default("NORMAL")
  // The four margins in inches (migration 20261017100000_page_size_rename_custom_margins). Always the
  // effective values: presets write their own numbers, CUSTOM stores the user's. 0 to 3 in, step 0.1.
  marginTop    Float  @default(1)
  marginBottom Float  @default(1)
  marginLeft   Float  @default(1)
  marginRight  Float  @default(1)
  headerLeft   String @default("")
  headerCenter String @default("")
  headerRight  String @default("")
  footerLeft   String @default("")
  footerCenter String @default("")
  footerRight  String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  editEvents   EditEvent[]
  editSessions EditSession[]
  comments     Comment[]
  documentContributions DocumentContribution[]
  snapshots    DocumentSnapshot[]
}

// A point-in-time copy of Document.yjsState, taken whenever an analysis run produces a new
// Report for an EDITOR/COMBINED assignment (server/src/routes/analyze.ts). The write is a plain
// copy of the already-current, already-debounce-persisted yjsState column (see persistence.ts) —
// it never touches the live Y.Doc, never calls getYDoc(), and registers no Yjs update listener,
// so it has zero interaction with authorshipCapture.ts's collab pipeline. Reconstruction to
// readable document structure happens later, at read time, by feeding yjsState into the same
// scratch-Y.Doc pattern documentExport.ts already uses.
model DocumentSnapshot {
  id         Int      @id @default(autoincrement())
  documentId Int
  reportId   Int?
  yjsState   Bytes
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  report     Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
}

// Discussion attached to a point in a Document's content — pure metadata, never document
// content itself. Anchored via an encoded Yjs RelativePosition (or CollaborationMappablePosition
// JSON), resolved to a live position client-side; the anchor bytes are opaque to the server and
// never read or written by authorshipCapture.ts or any Yjs update listener. Comments are reached
// only through plain REST routes (server/src/routes/comments.ts) — the same "context only" shape
// as Task/Dispute/RoleSuggestion. Purely informational — never read by shared/src/scoring.ts and
// never folded into contributionShare/flags/Gini.
model Comment {
  id         Int       @id @default(autoincrement())
  documentId Int
  authorId   Int
  text       String
  anchor     Bytes
  parentId   Int?      // null = thread root; set = reply (flat, one level deep)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id])
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")
}

// Raw log of every insertion/deletion made in a Document's live text, attributed to the
// authenticated user whose Yjs connection produced the update. position/length are offsets
// into a flattened plain-text view of the document (concatenated text-node content, no
// separator between blocks — see server/src/collab/authorshipCapture.ts). Shape (position/
// length) is still the source of truth for scoring/diffing; insertedText/deletedText are an
// additive disclosure capture only — see the doc comment on those fields below.
model EditEvent {
  id         Int           @id @default(autoincrement())
  documentId Int
  userId     Int
  eventType  EditEventType
  position   Int
  length     Int
  timestamp  DateTime      @default(now())
  // Significance classification (Step 4b) — set at capture time for INSERT events only.
  editType   EditType?
  // LIVE vs. a future .docx-import feature (not yet built) — see EditSource.
  source     EditSource    @default(LIVE)
  // Literal substring captured alongside the existing position/length shape (INSERT: the
  // inserted text; DELETE: the deleted text) — derived via before/after.slice() in
  // authorshipCapture.ts's diffText flow, where both full strings are already in memory. Nullable
  // so pre-migration rows remain valid. Purely additive: never read by scoring/diffing/editType
  // classification, which all still operate on position/length exactly as before.
  insertedText String?
  deletedText  String?
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])

  @@index([documentId, timestamp])
}

// A contiguous burst of editing activity by one user in one Document. Begins on a member's
// first EditEvent after being idle; ends (endedAt set) after 30 minutes with no further
// EditEvents from that member. Not FK-linked to EditEvent rows — both are independent logs
// keyed by (documentId, userId, time).
model EditSession {
  id             Int       @id @default(autoincrement())
  documentId     Int
  userId         Int
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  // Gross characters inserted during this session (not net of deletions).
  characterCount Int       @default(0)
  // Gross count of image nodes inserted during this session (net new, not decremented on
  // delete — same "gross" convention as characterCount). Disclosed on the report; never fed
  // into any scoring formula. See server/src/collab/authorshipCapture.ts's countImageNodes.
  imageInsertCount Int     @default(0)
  // LIVE vs. a future .docx-import feature (not yet built) — see EditSource.
  source         EditSource @default(LIVE)
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id])

  @@index([documentId, userId])
}

// Persistent cache of raw per-commit GitHub diff data (server/src/lib/github.ts's
// fetchCommitDiffs). A commit SHA is immutable and globally unique within a repo, so once
// fetched a row is valid forever — no invalidation path exists or is needed. Caches the raw
// `files` array as returned by GitHub, not any derived/weighted score, so every read still
// flows through the same classification/weighting code as a fresh fetch.
model CachedCommitDiff {
  id        Int      @id @default(autoincrement())
  repo      String   // "owner/repo", lowercased
  sha       String
  files     String   // JSON.stringify of the commit's raw `files` array
  createdAt DateTime @default(now())

  @@unique([repo, sha])
}
