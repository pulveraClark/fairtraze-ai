# Copy to server/.env.test (gitignored) and fill in the Neon TEST branch's
# direct (non-pooled) connection string. See CLAUDE.md / the testing plan for
# how the branch is created — it is a separate Neon branch from production,
# not the same database.
TEST_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any fixed non-production value works — tests only sign/verify tokens
# within the test run, they never touch a real session.
AUTH_SECRET="test-secret-do-not-use-in-prod"

# Gemini/GitHub/Resend calls are mocked in server/test/setupEnv.ts, so these
# never need to be real keys for tests to pass. Left here only so module-load
# guards (e.g. lib/gemini.ts) don't throw before the mock takes effect.
GEMINI_API_KEY="test-gemini-key"
